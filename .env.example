# ---- Supabase (project: qr-platform) ----
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://mcuemtumualmvbwfcjrm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_GZegYbLySbjTxE0wPfu5zg_dFuCm1WH

# SECRET — server-only. Get it from Supabase Dashboard > Project Settings > API > service_role key.
# Used by the redirect engine to log scans (bypasses RLS). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app (used to build short-link / QR target URLs).
# Local: http://localhost:3000  |  Production: https://traxxr.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The host that serves scan redirects, e.g. https://traxxr.com
# In V1 this can equal NEXT_PUBLIC_APP_URL; swap to your Cloudflare short domain later.
NEXT_PUBLIC_REDIRECT_BASE_URL=http://localhost:3000

# Canonical base URL for link-in-bio pages (handles live at {BIO_URL}/@handle).
# Defaults to NEXT_PUBLIC_APP_URL. When you launch a dedicated short domain for
# bio pages later, set this once and every QR/share link updates automatically.
NEXT_PUBLIC_BIO_URL=http://localhost:3000

# SECRET — server-only. Encrypts third-party integration API keys at rest
# (AES-256-GCM). Generate one with:  openssl rand -base64 32
# Keep this ONLY in your server environment (Vercel). Never commit it. If it's
# ever rotated, previously saved integration keys must be re-entered.
ENCRYPTION_KEY=
